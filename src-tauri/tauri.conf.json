{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZPos Kasir",
  "version": "0.1.0",
  "identifier": "my.id.zpos.kasir",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "ZPos Kasir",
        "width": 900,
        "height": 700,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png"
    ]
  }
}
